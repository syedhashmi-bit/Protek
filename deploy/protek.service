[Unit]
# Bare-metal unit for a git-clone install at /var/www/Protek (the layout the
# README + docs/INSTALL.md quick-start assume). For the Debian/RPM package
# layout (/usr/share/protek, /var/lib/protek) see packaging/debian/protek.service.
Description=Protek - CrowdSec to MikroTik bouncer + NOC dashboard
Documentation=https://github.com/syedhashmi-bit/Protek
After=network-online.target crowdsec.service
Wants=network-online.target

[Service]
Type=simple
# gunicorn runs as root so it can reach the MikroTik API socket and shell out
# to cscli. Change User=/Group= if you run Protek under a dedicated account.
User=root
WorkingDirectory=/var/www/Protek
Environment=PATH=/var/www/Protek/venv/bin
EnvironmentFile=/var/www/Protek/.env
ExecStart=/var/www/Protek/venv/bin/gunicorn -w 3 -b 127.0.0.1:8090 --timeout 60 \
    --access-logfile - --error-logfile - app:app
Restart=on-failure
RestartSec=5

# Resource limits (2026-10-15): a runaway reconcile query once drove Protek
# to a 5.2G memory peak on a shared host. MemoryHigh throttles before MemoryMax
# hard-kills, so Restart= recovers the service instead of the host OOMing.
# Size these to your box.
MemoryHigh=1536M
MemoryMax=2560M

# Sandboxing. Protek still runs as root (see above), so these directives are
# what bounds the damage a file-write bug can do — a path-traversal in the
# scenario editor was a write-anywhere-as-root primitive until 2026-09-02.
# ReadWritePaths is the important line: everything else on / is read-only.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
# read-only, not yes: a uv-built venv's interpreter may live under
# /root/.local/share/uv, and hiding /root makes exec fail (status=203/EXEC).
# install.sh puts uv's Python under /opt/uv to avoid that, but older venvs don't.
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
UMask=0077
# /var/www/Protek — the DB, WAL and .poller.lock.
# /etc/crowdsec, /var/lib/crowdsec — the scenario editor and the hub catalog
#   (`cscli hub install` writes both).
# /run — runtime state; matches the live unit.
# /root/.gunicorn — gunicorn's control socket; the `-` makes it optional.
# Add any path a bouncer adapter or backup destination needs to write.
ReadWritePaths=/var/www/Protek /etc/crowdsec /var/lib/crowdsec /run -/root/.gunicorn

[Install]
WantedBy=multi-user.target
